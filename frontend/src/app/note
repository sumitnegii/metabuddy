                </FadeInUp>
                <div className="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5">
                    {[
                        { tag: "Sell what you know", grad: "linear-gradient(135deg,#fef3c7,#fde68a,#fbbf24)", desc: "Challenges, 1:1 sessions, courses, templates", icon: <Brain size={28} className="text-amber-700" />, label: "COURSES" },
                        { tag: "Sell what you make", grad: "linear-gradient(135deg,#d1fae5,#a7f3d0,#6ee7b7)", desc: "Jewelry, apparel, home decor", icon: <Sparkles size={28} className="text-emerald-700" />, label: "PRODUCTS" },
                        { tag: "Sell what you love", grad: "linear-gradient(135deg,#e9d5ff,#c4b5fd,#a78bfa)", desc: "Fitness classes, networking nights, dance classes", icon: <Heart size={28} className="text-purple-700" />, label: "SERVICES" },
                    ].map((c, i) => (
                        <FadeInUp key={c.tag} delay={i * 0.1}>
                            <div className="soft-card overflow-hidden h-full flex flex-col group">
                                <div className="aspect-[4/3] flex items-center justify-center relative overflow-hidden" style={{ background: c.grad }}>
                                    <div className="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10" />
                                    <div className="relative z-10 w-32 h-44 rounded-2xl bg-white/40 backdrop-blur-xl border border-white/50 shadow-2xl flex flex-col p-4 transform group-hover:scale-110 transition-transform duration-500">
                                        <div className="flex items-center justify-between mb-4">
                                            <div className="w-6 h-6 rounded-full bg-white/80 flex items-center justify-center">{c.icon}</div>
                                            <div className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                                        </div>
                                        <div className="flex-1 space-y-2">
                                            <div className="h-1.5 w-full bg-white/60 rounded-full" />
                                            <div className="h-1.5 w-2/3 bg-white/60 rounded-full" />
                                            <div className="h-1.5 w-1/2 bg-white/60 rounded-full" />
                                        </div>
                                        <div className="mt-auto h-6 w-full bg-slate-900 rounded-lg shadow-lg" />
                                    </div>
                                </div>
                                <div className="p-8">
                                    <span className="text-[10px] font-bold text-slate-400 uppercase tracking-[0.2em] mb-2 block">{c.label}</span>
                                    <h3 className="font-bold text-slate-900 text-xl mb-3">{c.tag}</h3>
                                    <p className="text-sm text-slate-500 leading-relaxed font-medium">{c.desc}</p>
                                </div>
                            </div>
                        </FadeInUp>
                    ))}
                </div>
            </section>

            {/* ── Live Agent Activity ── */}
            <section className="py-28 px-4 relative z-10">
                <FadeInUp className="text-center mb-3">
                    <span className="section-label accent-text">✦ Magic Agents</span>
                </FadeInUp>
                <FadeInUp delay={0.05} className="text-center mb-12">
                    <h2 className="heading text-4xl sm:text-5xl">
                        AI working <span className="serif-italic font-medium text-slate-700">24/7 for you.</span>
                    </h2>
                    <p className="muted-text text-lg max-w-2xl mx-auto mt-4">
                        Watch your agents optimize campaigns in real time — pause losers, scale winners, refresh creatives.
                    </p>
                </FadeInUp>
                <div className="max-w-2xl mx-auto">
                    <div className="soft-card overflow-hidden">
                        <div className="flex items-center gap-2 px-5 py-3.5 border-b" style={{ borderColor: "rgba(15,23,42,0.06)", background: "#fafaf6" }}>
                            <div className="w-2.5 h-2.5 rounded-full bg-rose-400" />
                            <div className="w-2.5 h-2.5 rounded-full bg-amber-400" />
                            <div className="w-2.5 h-2.5 rounded-full bg-emerald-400" />
                            <span className="ml-2 text-[11px] text-slate-500 font-mono">metabuddy-agent · live</span>
                            <div className="ml-auto flex items-center gap-1.5">
                                <div className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                                <span className="text-[10px] text-emerald-600 font-semibold">active</span>
                            </div>
                        </div>
                        <div className="px-5 py-4 min-h-[280px] space-y-2">
                            <AnimatePresence>
                                {visibleAgents.map((msg, i) => {
                                    const badge = AGENT_BADGE[msg.type];
                                    const isLatest = i === visibleAgents.length - 1;
                                    return (
                                        <motion.div key={`${msg.text}-${i}`}
                                            initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}
                                            exit={{ opacity: 0, height: 0, marginBottom: 0 }}
                                            transition={{ duration: 0.35 }}
                                            className="flex items-center gap-2.5 py-2 border-b last:border-0"
                                            style={{ borderColor: "rgba(15,23,42,0.05)" }}>
                                            <span className={clsx("text-[9px] font-bold px-2 py-0.5 rounded-full flex-shrink-0", badge.cls)}>
                                                {badge.label}
                                            </span>
                                            <span className={clsx("text-xs flex-1 font-mono", isLatest ? "text-slate-800" : "text-slate-400")}>
                                                {msg.text}
                                            </span>
                                            {isLatest && <span className="inline-block w-1.5 h-3.5 bg-orange-400 animate-pulse rounded-sm" />}
                                        </motion.div>
                                    );
                                })}
                            </AnimatePresence>
                        </div>
                    </div>
                </div>
            </section>

            {/* ── Stats ── */}
            <section className="py-32 px-4 relative z-10 bg-[#fafafa] overflow-hidden">
                <div className="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />
                <FadeInUp className="text-center mb-16">
                    <h2 className="heading text-6xl sm:text-8xl tracking-tight">
                        <span style={{ background: "linear-gradient(135deg,#0f172a,#ff6b47,#fbbf24)", WebkitBackgroundClip: "text", WebkitTextFillColor: "transparent" }}>
                            350,000+
                        </span>
                    </h2>
                    <p className="muted-text text-xl mt-6">Campaigns launched on MetaBuddy and counting…</p>
                </FadeInUp>
                <div className="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-6">
                    {[
                        { value: 3.2, suffix: "x", label: "Average ROAS", icon: <TrendingUp size={20} /> },
                        { value: 40, suffix: "%", label: "Lower CPC", icon: <Zap size={20} /> },
                        { value: 2, suffix: " min", label: "Time to live", icon: <Rocket size={20} /> },
                    ].map((stat, i) => (
                        <FadeInUp key={stat.label} delay={i * 0.1}>
                            <div className="soft-card p-10 text-center group hover:bg-white transition-all duration-500">
                                <div className="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center mx-auto mb-6 text-slate-400 group-hover:text-orange-500 transition-colors">
                                    {stat.icon}
                                </div>
                                <div className="text-5xl font-bold text-slate-900 mb-3 tracking-tight">
                                    <Counter target={stat.value} suffix={stat.suffix} />
                                </div>
                                <p className="text-slate-500 text-sm font-bold uppercase tracking-[0.15em]">{stat.label}</p>
                            </div>
                        </FadeInUp>
                    ))}
                </div>
            </section>

            {/* ── Testimonials ── */}
            <section className="py-28 px-4 relative z-10">
                <FadeInUp className="text-center mb-16">
                    <span className="section-label accent-text">✦ Stories</span>
                    <h2 className="heading text-4xl sm:text-5xl mt-3">
                        Stories from people who <span className="serif-italic font-medium text-slate-700">started.</span>
                    </h2>
                </FadeInUp>
                <div className="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5">
                    {[
                        { name: "Morena V.", role: "Yoga Teacher", quote: "Just 12 hours in and already 2 leads. My third ad is performing the best — proof that showing up as yourself works.", grad: "linear-gradient(135deg,#fef3c7,#fbbf24)" },
                        { name: "Nate G.", role: "Solopreneur", quote: "I've run my own business for 17 years. MetaBuddy has been a game changer for adding another aspect to my marketing.", grad: "linear-gradient(135deg,#e9d5ff,#c4b5fd)" },
                        { name: "Dominique", role: "Coach", quote: "Never got a lead in 2 years on the old platform. Got 5 leads in 2 days on MetaBuddy.", grad: "linear-gradient(135deg,#d1fae5,#86efac)" },
                    ].map((t, i) => (
                        <FadeInUp key={t.name} delay={i * 0.1}>
                            <div className="soft-card p-6 h-full flex flex-col">
                                <div className="flex items-center gap-1 mb-3">
                                    {[...Array(5)].map((_, j) => <Star key={j} size={13} className="text-amber-400 fill-amber-400" />)}
                                </div>
                                <p className="text-sm text-slate-700 leading-relaxed flex-1 mb-5">"{t.quote}"</p>
                                <div className="flex items-center gap-3 pt-4 border-t" style={{ borderColor: "rgba(15,23,42,0.06)" }}>
                                    <div className="w-10 h-10 rounded-full" style={{ background: t.grad }} />
                                    <div>
                                        <p className="text-sm font-semibold text-slate-900">{t.name}</p>
                                        <p className="text-xs text-slate-500">{t.role}</p>
                                    </div>
                                </div>
                            </div>
                        </FadeInUp>
                    ))}
                </div>
            </section>

            {/* ── Pricing ── */}
            <section id="pricing" className="py-28 px-4 relative z-10 bg-sage">
                <FadeInUp className="text-center mb-3">
                    <span className="section-label accent-text">✦ Pricing</span>
                </FadeInUp>
                <FadeInUp delay={0.05} className="text-center mb-16">
                    <h2 className="heading text-4xl sm:text-5xl">
                        Simple, <span className="serif-italic font-medium text-slate-700">honest pricing.</span>
                    </h2>
                    <p className="muted-text text-lg mt-4">Start free. Scale when you're ready.</p>
                </FadeInUp>
                <div className="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-5">
                    {PRICING.map((plan, i) => (
